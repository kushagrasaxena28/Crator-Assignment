# Copy this file to .env (`cp .env.example .env`) and fill in real values.
# .env is gitignored — nothing you put there ever gets committed.

# Django's own secret key (separate from JWT_SECRET). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY="replace-with-a-real-django-secret-key"

# Defaults to false when unset, so a missing value fails towards the safe setting.
DJANGO_DEBUG="true"

# Signs and verifies every token this backend issues — both user and agent. Generate a real one,
# and never ship the literal value below:
#   openssl rand -hex 32
JWT_SECRET="replace-with-a-real-random-secret"

JWT_EXPIRES_IN_MINUTES=20

# --- Optional: seeding ---
# `python manage.py seed` generates the demo user's password and the demo agent's secret at random
# and prints them once. Set either of these to choose the value instead — useful for a reproducible
# local setup, and the only way to rotate a credential on a database that already has one.
#   openssl rand -hex 12
# DEMO_USER_PASSWORD=""
# DEMO_AGENT_SECRET=""

# Note: user passwords and agent secrets are NOT configuration. They live in the database as
# PBKDF2 hashes; the two variables above only seed them.
