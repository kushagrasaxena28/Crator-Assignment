# Copy this file to .env (`cp .env.example .env`) and fill in real values.
# .env is gitignored — nothing you put there ever gets committed.

# Django's own secret key (separate from JWT_SECRET). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY="replace-with-a-real-django-secret-key"
DJANGO_DEBUG="true"

# Signs and verifies every agent JWT. Generate a real one — never ship the literal value below:
#   openssl rand -hex 32
JWT_SECRET="replace-with-a-real-random-secret"

JWT_EXPIRES_IN_MINUTES=20

# HTTP Basic credentials for the human reviewer's PATCH .../resolve/ endpoint.
ADMIN_USER="admin"
# Generate a real one:
#   openssl rand -hex 12
ADMIN_PASSWORD="password"

# Required only for the `notion` toolkit (list_pages/create_page/update_page/delete_page) — a
# genuine live integration, unlike items/github. Items/github work without these.
# 1. Create an internal integration at https://www.notion.so/my-integrations, enable Read/
#    Update/Insert content, copy its secret (starts with ntn_ or secret_).
# 2. Share a page with that integration in your workspace ("..." menu -> Connections).
# 3. Paste that page's id below (from its URL) — new pages get created under it.
NOTION_API_KEY="ntn_your_integration_secret_here"
NOTION_PARENT_PAGE_ID="your_shared_page_id_here"
