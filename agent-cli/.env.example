# Copy this file to .env (`cp .env.example .env`) and fill in real values.
# .env is gitignored — nothing you put there ever gets committed.

BACKEND_URL="http://localhost:8000"

# The seeded demo agent's UUID (created when the backend is seeded).
# Only needs to change if you seed a different/additional agent.
AGENT_ID="00000000-0000-0000-0000-000000000001"

# The agent's credential, printed once by `python manage.py seed`. Together with AGENT_ID it is
# exchanged for a short-lived agent token; an id on its own is not enough.
#
# This file must NEVER contain the owning user's password. The agent running here has shell
# access, so anything in this file is readable by the model — and a user password would let it
# mint a user token and approve its own held actions, which is exactly what the approval queue
# exists to prevent. An agent secret only ever yields an agent token.
AGENT_SECRET="paste-the-agent-secret-printed-by-seed"

# Only needed if you do NOT have a `claude` CLI logged in. Check with `claude auth status`; if it
# reports loggedIn, leave this line commented out and the SDK will use that login.
#
# Deliberately shipped commented out. An uncommented placeholder is the worst of both worlds: the
# SDK treats any set value as a configured credential and stops falling back to your `claude`
# login, so a copied-but-unedited value breaks a setup that would otherwise have worked.
# Get a real key at https://console.anthropic.com/settings/keys if you need one.
# ANTHROPIC_API_KEY="sk-ant-your-key-here"
