# Copy this file to .env (`cp .env.example .env`) and fill in real values.
# .env is gitignored — nothing you put there ever gets committed.

BACKEND_URL="http://localhost:8000"

# The seeded demo agent's UUID (created when the backend is seeded).
# Only needs to change if you seed a different/additional agent.
AGENT_ID="00000000-0000-0000-0000-000000000001"

# REQUIRED on any machine that doesn't already have a `claude` CLI logged in (this is the
# normal case — assume you need this). Get a key at https://console.anthropic.com/settings/keys
# and paste it below. The Claude Agent SDK's subprocess inherits this process's environment, so
# once it's set here, no other configuration is needed for it to be picked up.
ANTHROPIC_API_KEY="sk-ant-your-key-here"
